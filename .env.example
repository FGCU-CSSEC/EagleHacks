# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard > your project > Project Settings > API Keys

# Project URL (Project Settings > Data API > Project URL). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "Publishable key" (sb_publishable_...). Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (sb_secret_...). SERVER ONLY, bypasses RLS. Not used by any code yet;
# add it in Vercel (not marked public) when server routes need it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Airtable, SERVER ONLY. Used by scripts/setup-airtable.ts.
# Token: airtable.com/create/tokens, scopes schema.bases:read and schema.bases:write
# (add data.records:read/write later for the app), access limited to the one base.
AIRTABLE_TOKEN=
# Base ID: the "app..." part of the base's URL.
AIRTABLE_BASE_ID=
